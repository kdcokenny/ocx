{
	"name": "kdco-registry",
	"private": true,
	"scripts": {
		"build": "bun scripts/build.ts",
		"check": "bun run check:types",
		"check:types": "tsc --noEmit -p tsconfig.json",
		"deploy": "bun run build && wrangler deploy",
		"dev": "bun run build && wrangler dev --inspector-port 0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.11",
		"@types/node": "^25.5.0",
		"ocx": "workspace:*"
	}
}
